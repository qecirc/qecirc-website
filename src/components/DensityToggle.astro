---
/**
 * Toggle between compact circuit rows (first tag + "+k" rest count, one line
 * per row — the default) and full rows (every tag, wrapping as needed).
 *
 * The state lives as `data-density="full"` on <html> — absent means compact —
 * so the pure-CSS rules in global.css apply everywhere at once, and it
 * persists in localStorage across pages. The default renders without JS;
 * a stored "full" preference is applied on load.
 *
 * The button label names the view you would switch TO, matching the
 * "all tags" / "by category" toggle it sits beside.
 */
---

<button
  type="button"
  data-density-toggle
  class="text-xs text-gray-500 dark:text-gray-400 underline hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer"
  title="Toggle between compact rows (first tag only) and full rows (all tags)"></button>

<script>
  const KEY = "qecirc:circuit-density";

  function currentDensity(): "full" | "compact" {
    return localStorage.getItem(KEY) === "full" ? "full" : "compact";
  }

  function applyDensity(density: "full" | "compact"): void {
    if (density === "full") {
      document.documentElement.setAttribute("data-density", "full");
    } else {
      document.documentElement.removeAttribute("data-density");
    }
    document.querySelectorAll<HTMLButtonElement>("[data-density-toggle]").forEach((btn) => {
      btn.textContent = density === "full" ? "compact rows" : "full rows";
      btn.setAttribute("aria-pressed", String(density === "full"));
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-density-toggle]").forEach((btn) => {
    if (btn.dataset.initialized) return;
    btn.dataset.initialized = "1";
    btn.addEventListener("click", () => {
      const next = currentDensity() === "full" ? "compact" : "full";
      localStorage.setItem(KEY, next);
      applyDensity(next);
    });
  });

  applyDensity(currentDensity());
</script>
