---
import type { CircuitBody } from "../types";
import { TAB_ACTIVE_CLASS, TAB_INACTIVE_CLASS } from "../lib/constants";
import { ANNOTATED_OF, hasQubitCoords, splitAnnotated } from "../lib/stim-format";
import CodeBlock from "./CodeBlock.astro";
import CoordsToggle from "./CoordsToggle.astro";
import DetectorsToggle from "./DetectorsToggle.astro";

// KEEP THE TAB MARKUP IN SYNC with CircuitBodiesTemplate.astro, which is
// cloned client-side on code pages (this component renders only on circuit
// detail pages).

interface Props {
  bodies: CircuitBody[];
  stimFilename?: string;
  source?: string;
}

const { bodies, stimFilename, source } = Astro.props;

// The annotated body is a view of the STIM body, not a format of its own, so it
// gets no tab — the Detectors switch swaps it in behind the STIM tab.
const { tabs, annotated } = splitAnnotated(bodies);
const hasMultipleFormats = tabs.length > 1;

// Both switches belong to one format (only STIM carries coordinates or an
// annotated variant) but share the tab row with all of them — they are hidden
// while another format is selected, rather than left doing nothing. See
// format-switcher-client.
const coordsFormat = tabs.find((b) => hasQubitCoords(b.body))?.format
  ?? (annotated && hasQubitCoords(annotated) ? ANNOTATED_OF : undefined);
const detectorsFormat = annotated ? ANNOTATED_OF : undefined;
const switchFormat = coordsFormat ?? detectorsFormat;

function annotatedFor(format: string): string | undefined {
  return format === ANNOTATED_OF ? annotated : undefined;
}

function downloadNameFor(format: string): string | undefined {
  if (!stimFilename) return undefined;
  return stimFilename.replace(/\.stim$/, `.${format}`);
}

const TAB_BASE_CLASS =
  "format-tab px-3 py-1.5 text-xs font-semibold rounded-md cursor-pointer transition-colors";
---

{hasMultipleFormats ? (
  <div class="format-switcher" data-coords-format={switchFormat}>
    <div class="flex items-center gap-0.5 mb-2">
      {tabs.map((b, i) => (
        <button
          class:list={[TAB_BASE_CLASS, i === 0 ? TAB_ACTIVE_CLASS : TAB_INACTIVE_CLASS]}
          data-format={b.format}
          title={`Switch to ${b.format.toUpperCase()} (${i + 1})`}
        >
          {b.format.toUpperCase()}
          {i < 3 && (
            <kbd class="ml-1.5 inline-block min-w-[1rem] text-center px-1 rounded border border-gray-300 dark:border-gray-700 bg-white/60 dark:bg-gray-900/60 text-[10px] text-gray-400 dark:text-gray-500 font-mono">
              {i + 1}
            </kbd>
          )}
        </button>
      ))}
      {switchFormat && (
        <div class="ml-auto flex items-center gap-0.5" data-body-switches>
          {detectorsFormat && <DetectorsToggle />}
          {coordsFormat && <CoordsToggle />}
        </div>
      )}
    </div>
    {tabs.map((b, i) => (
      <div class="format-body" data-format={b.format} style={i === 0 ? "" : "display:none"}>
        <CodeBlock
          code={b.body}
          annotated={annotatedFor(b.format)}
          label={`${b.format.toUpperCase()} Circuit`}
          downloadName={downloadNameFor(b.format)}
          source={source}
          coordsToggle={false}
        />
      </div>
    ))}
  </div>
) : tabs.length === 1 ? (
  <CodeBlock
    code={tabs[0].body}
    annotated={annotatedFor(tabs[0].format)}
    label={`${tabs[0].format.toUpperCase()} Circuit`}
    downloadName={downloadNameFor(tabs[0].format)}
    source={source}
  />
) : (
  <p class="text-sm text-gray-400">No circuit body available.</p>
)}

<script>
  import { initFormatSwitchers } from "../lib/format-switcher-client";
  initFormatSwitchers();
</script>
