---
import TagList from "./TagList.astro";
import type { CodeWithMeta } from "../types";
import { formatCodeParams } from "../lib/queries";

interface Props {
  code: CodeWithMeta;
  /** Path tag links point at (the host page's own path). */
  basePath: string;
  /** Pass on pages where tag clicks must navigate and preserve other params
   *  (e.g. /search keeping ?q=); omit where list-filter-client intercepts them. */
  baseUrl?: URL;
  selectedTags?: string[];
}

const { code, basePath, baseUrl, selectedTags } = Astro.props;
const { name, slug, tags, circuit_count } = code;
const params = formatCodeParams(code);
const showParams = params !== "" && name !== params;

// Row data consumed by list-filter-client.ts (client-side filtering/sorting).
const rowMetrics = JSON.stringify({ n: code.n, k: code.k, d: code.d ?? null });
const rowTags = JSON.stringify(tags);
---

<div
  class="rounded border border-gray-200 dark:border-gray-800 p-4 hover:border-gray-400 dark:hover:border-gray-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40"
  tabindex="0"
  data-list-row
  data-filter-row
  data-name={name}
  data-metrics={rowMetrics}
  data-tags={rowTags}
>
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <a href={`/codes/${slug}`} class="flex items-baseline gap-2" data-list-link>
      <h3 class="font-medium">{name}</h3>
      {showParams && <span class="text-sm text-gray-500 dark:text-gray-400">{params}</span>}
      <span class="text-xs text-gray-400 dark:text-gray-500">{circuit_count} {circuit_count === 1 ? "circuit" : "circuits"}</span>
    </a>
    <div class="ml-auto">
      <TagList tags={tags} basePath={basePath} baseUrl={baseUrl} selectedTags={selectedTags} />
    </div>
  </div>
</div>
