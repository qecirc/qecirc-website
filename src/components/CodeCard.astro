---
import TagList from "./TagList.astro";
import type { CodeWithMeta } from "../types";

interface Props {
  code: CodeWithMeta;
  /** Path tag links point at (the host page's own path). */
  basePath: string;
  /** Pass on pages where tag clicks must navigate and preserve other params
   *  (e.g. /search keeping ?q=); omit where list-filter-client intercepts them. */
  baseUrl?: URL;
  selectedTags?: string[];
}

const { code, basePath, baseUrl, selectedTags } = Astro.props;
const { name, slug, tags, circuit_count } = code;

// Row data consumed by list-filter-client.ts (client-side filtering/sorting).
const rowMetrics = JSON.stringify({ n: code.n, k: code.k, d: code.d ?? null });
const rowTags = JSON.stringify(tags);

// n, k and d are columns of their own (the table header sorts on them), so a
// missing value shows as a dash rather than being omitted — the column keeps
// its width either way.
const numCls = "px-2 py-2 text-right align-baseline font-mono text-[13px] tabular-nums";
---

<tr
  class="border-b border-gray-200 dark:border-gray-800 hover:bg-gray-50 dark:hover:bg-gray-900/60 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500/40"
  tabindex="0"
  data-list-row
  data-filter-row
  data-name={name}
  data-metrics={rowMetrics}
  data-tags={rowTags}
>
  <td class="py-2 pr-3 align-baseline">
    <a href={`/codes/${slug}`} class="text-sm font-medium hover:underline" data-list-link>{name}</a>
  </td>
  <td class={numCls}>{code.n ?? "–"}</td>
  <td class={numCls}>{code.k ?? "–"}</td>
  <td class={numCls}>{code.d ?? "–"}</td>
  <td class={`${numCls} text-gray-500 dark:text-gray-400`}>{circuit_count}</td>
  <td class="py-2 pl-4 align-baseline hidden md:table-cell">
    <TagList
      tags={tags}
      basePath={basePath}
      baseUrl={baseUrl}
      selectedTags={selectedTags}
      class="justify-end"
    />
  </td>
</tr>
