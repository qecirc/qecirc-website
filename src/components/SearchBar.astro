---
---

<div class="search-bar relative">
  <input
    type="text"
    class="search-input w-48 rounded border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-3 py-1.5 pr-8 text-sm placeholder-gray-400 focus:border-gray-400 dark:focus:border-gray-500 focus:outline-none"
    placeholder="Search codes & circuits..."
    aria-label="Search codes, circuits, and tools"
    autocomplete="off"
  />
  <kbd aria-hidden="true" class="search-hint pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 px-1.5 py-0.5 text-[10px] text-gray-500 dark:text-gray-400 font-sans">/</kbd>
  <ul
    class="search-results absolute right-0 top-full mt-1 w-96 rounded border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-lg hidden z-50 max-h-80 overflow-y-auto"
    role="listbox"
    aria-live="polite"
    aria-label="Search results"
  >
  </ul>
</div>

<script>
  import { isInputFocused } from "../lib/dom-helpers";

  // The layout renders one SearchBar for desktop and one for mobile; Astro
  // runs this script once, so each instance is wired up individually.
  document.querySelectorAll<HTMLElement>(".search-bar").forEach(initSearchBar);

  function initSearchBar(container: HTMLElement, instance: number) {
  const input = container.querySelector("input") as HTMLInputElement;
  const resultsList = container.querySelector("ul") as HTMLUListElement;

  let debounceTimer: ReturnType<typeof setTimeout>;
  let activeIndex = -1;
  let cachedItems: NodeListOf<HTMLLIElement> | HTMLLIElement[] = [];

  function show() {
    resultsList.classList.remove("hidden");
  }

  function hide() {
    resultsList.classList.add("hidden");
    activeIndex = -1;
    input.removeAttribute("aria-activedescendant");
  }

  function updateActive() {
    const items = resultsList.querySelectorAll("li");
    items.forEach(function (item, i) {
      const active = i === activeIndex;
      item.setAttribute("aria-selected", active ? "true" : "false");
      if (active) {
        item.classList.add("bg-gray-100", "dark:bg-gray-800");
      } else {
        item.classList.remove("bg-gray-100", "dark:bg-gray-800");
      }
    });
    if (activeIndex >= 0 && items[activeIndex]) {
      input.setAttribute("aria-activedescendant", (items[activeIndex] as HTMLElement).id);
    } else {
      input.removeAttribute("aria-activedescendant");
    }
  }

  function navigateTo(href: string) {
    window.location.href = href;
  }

  async function doSearch(query: string) {
    if (query.length < 2) {
      hide();
      return;
    }

    const res = await fetch("/api/search?q=" + encodeURIComponent(query));
    const results: { type: string; name: string; slug: string; qec_id?: string; params: string; tags: string[]; href: string; subtitle?: string }[] = await res.json();

    resultsList.innerHTML = "";
    activeIndex = -1;
    cachedItems = [];

    if (results.length === 0) {
      resultsList.innerHTML = '<li class="px-3 py-2 text-sm text-gray-500 dark:text-gray-400">No results</li>';
      appendAdvanced(query);
      cachedItems = resultsList.querySelectorAll<HTMLLIElement>("li[data-href]");
      show();
      return;
    }

    results.forEach(function (item, i) {
      const li = document.createElement("li");
      li.className = "px-3 py-2 text-sm cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-800";
      li.id = `search-result-${instance}-${i}`;
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", "false");
      li.dataset.slug = item.slug;
      li.dataset.href = item.href;

      const topRow = document.createElement("div");
      topRow.className = "flex items-baseline gap-1.5";

      const nameSpan = document.createElement("span");
      nameSpan.className = "font-medium";
      nameSpan.textContent = item.name;
      topRow.appendChild(nameSpan);

      if (item.params) {
        const paramsSpan = document.createElement("span");
        paramsSpan.className = "text-gray-500 dark:text-gray-400";
        paramsSpan.textContent = item.params;
        topRow.appendChild(paramsSpan);
      }

      li.appendChild(topRow);

      const meta: string[] = [];
      meta.push(item.type);
      if (item.qec_id) meta.push(item.qec_id);
      if (item.subtitle) meta.push(item.subtitle);
      const metaDiv = document.createElement("div");
      metaDiv.className = "text-xs text-gray-500 dark:text-gray-400";
      metaDiv.textContent = meta.join(" · ");
      li.appendChild(metaDiv);

      li.addEventListener("click", function () {
        navigateTo(item.href);
      });

      resultsList.appendChild(li);
    });

    appendAdvanced(query);
    cachedItems = resultsList.querySelectorAll<HTMLLIElement>("li[data-href]");
    show();
  }

  // This dropdown caps out at 20 codes / 10 circuits / 10 tools and matches
  // names and tags only. /search reads circuit notes too and ranks by
  // relevance, so offer it as the way out -- especially on "No results".
  function appendAdvanced(query: string) {
    const href = "/search?q=" + encodeURIComponent(query);
    const li = document.createElement("li");
    li.className =
      "px-3 py-2 text-sm cursor-pointer border-t border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800";
    li.setAttribute("role", "option");
    li.setAttribute("aria-selected", "false");
    li.dataset.href = href;
    li.textContent = `Search all circuits for "${query}" →`;
    li.addEventListener("click", function () {
      navigateTo(href);
    });
    resultsList.appendChild(li);
  }

  input.addEventListener("input", function () {
    updateHint();
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(function () {
      doSearch(input.value.trim());
    }, 200);
  });

  input.addEventListener("keydown", function (e) {
    const items = cachedItems;

    // Enter without a highlighted result hands over to /search. This bar is for
    // jumping to a known code/circuit/tool; pressing Enter means "I want results,
    // not this list". Handled ahead of the no-items guard on purpose: an empty
    // dropdown is exactly when /search helps most, since it also reads notes and
    // tolerates typos this LIKE-matched dropdown cannot.
    if (e.key === "Enter" && activeIndex < 0) {
      const q = input.value.trim();
      if (q.length < 2) return;
      e.preventDefault();
      navigateTo("/search?q=" + encodeURIComponent(q));
      return;
    }

    if (items.length === 0) return;

    if (e.key === "ArrowDown") {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
      updateActive();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      updateActive();
    } else if (e.key === "Enter" && activeIndex >= 0) {
      e.preventDefault();
      const href = (items[activeIndex] as HTMLElement).dataset.href;
      if (href) navigateTo(href);
    } else if (e.key === "Escape") {
      hide();
    }
  });

  document.addEventListener("click", function (e) {
    if (!container.contains(e.target as Node)) {
      hide();
    }
  });

  const hint = container.querySelector(".search-hint") as HTMLElement;

  function updateHint() {
    hint.classList.toggle("hidden", input === document.activeElement || input.value.length > 0);
  }

  input.addEventListener("focus", updateHint);
  input.addEventListener("blur", updateHint);
  }

  const w = window as unknown as Record<string, boolean>;
  if (!w.__searchShortcutBound) {
    w.__searchShortcutBound = true;
    document.addEventListener("keydown", function (e) {
      if (e.key !== "/") return;
      if (isInputFocused()) return;
      e.preventDefault();
      const allInputs = document.querySelectorAll<HTMLInputElement>(".search-input");
      const visible = Array.from(allInputs).find(function (inp) { return inp.offsetParent !== null; });
      if (visible) visible.focus();
    });
  }
</script>
