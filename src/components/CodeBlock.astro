---
import { bodyForDisplay, hasQubitCoords, lineNumbered } from "../lib/stim-format";
import CoordsToggle from "./CoordsToggle.astro";

interface Props {
  code: string;
  label?: string;
  downloadName?: string;
  source?: string;
  /** The detector-annotated variant of `code`, when the circuit has one. */
  annotated?: string;
  /** Render the coords switch above the block. FormatSwitcher sets this false
   *  and puts the switch in its own tab row instead. */
  coordsToggle?: boolean;
}

// KEEP THE CODE-BLOCK MARKUP IN SYNC with CircuitBodiesTemplate.astro, which
// is cloned client-side on code pages (this component renders only on
// circuit detail pages).
const { code, label, downloadName, source, annotated, coordsToggle = true } = Astro.props;

const raw = code.trimEnd();
const annotatedRaw = annotated?.trimEnd();
const hasCoords = hasQubitCoords(raw) || (!!annotatedRaw && hasQubitCoords(annotatedRaw));
// Render the default state server-side (coordinates hidden, canonical body) so
// there is no flash before the switches initialise, and so it reads correctly
// without JS.
const formatted = lineNumbered(bodyForDisplay(raw, false));
const ownToggle = coordsToggle && hasCoords;
// The switches derive what is shown from these, so the block needs the full
// body whenever either switch is live — not only when it has coordinates.
const needsRaw = hasCoords || !!annotatedRaw;
---

<div data-coords-scope={ownToggle ? "" : undefined}>
  {ownToggle && (
    <div class="flex justify-end mb-2">
      <CoordsToggle />
    </div>
  )}
  <div
    class="rounded border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 overflow-hidden"
    data-code-block
    data-source={source ?? ""}
    data-raw-code={needsRaw ? raw : undefined}
    data-annotated-code={annotatedRaw}
  >
    <div class="border-b border-gray-200 dark:border-gray-800 px-4 py-2 text-xs text-gray-500 dark:text-gray-400 flex items-center justify-between">
      <span>{label ?? ""}</span>
      <div class="flex items-center gap-3.5">
        {downloadName && (
          <button
            class="download-btn flex items-center gap-1 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 cursor-pointer"
            data-download-name={downloadName}
            aria-label="Download file"
            title={`Download ${downloadName} (d)`}
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" />
            </svg>
            <span>Download</span>
            <kbd class="ml-0.5 inline-block min-w-[1rem] text-center px-1 rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-[10px] text-gray-400 dark:text-gray-500 font-mono">
              d
            </kbd>
          </button>
        )}
        <button
          class="copy-btn flex items-center gap-1 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 cursor-pointer"
          data-code={bodyForDisplay(raw, false)}
          aria-label="Copy to clipboard"
          title="Copy to clipboard (c)"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <span class="copy-label">Copy</span>
          <kbd class="ml-0.5 inline-block min-w-[1rem] text-center px-1 rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-[10px] text-gray-400 dark:text-gray-500 font-mono">
            c
          </kbd>
        </button>
      </div>
    </div>
    <pre class="overflow-x-auto p-4 text-sm leading-relaxed"><code set:text={formatted} /></pre>
  </div>
</div>

<script>
  import { copyToClipboard } from "../lib/dom-helpers";
  import { initBodyViews } from "../lib/body-view-client";

  initBodyViews();

  document.querySelectorAll<HTMLElement>("[data-code-block]:not([data-initialized])").forEach(function (block) {
    block.setAttribute("data-initialized", "");

    const source = block.dataset.source || "";

    function citeNotice() {
      if (typeof window.showCiteToast === "function") {
        if (source && source.startsWith("http")) {
          window.showCiteToast("Please cite the source when using this circuit:", source);
        } else if (source) {
          window.showCiteToast("Please cite the source when using this circuit: " + source);
        } else {
          window.showCiteToast("Please check and cite the corresponding source when using this circuit.");
        }
      }
    }

    block.querySelectorAll(".copy-btn").forEach(function (btn) {
      btn.addEventListener("click", async function () {
        const code = (btn as HTMLElement).dataset.code || "";
        const ok = await copyToClipboard(code);
        if (!ok) return;
        const label = btn.querySelector(".copy-label") as HTMLElement | null;
        if (label) {
          const original = label.textContent;
          label.textContent = "Copied!";
          setTimeout(function () { label.textContent = original; }, 1500);
        }
        citeNotice();
      });
    });

    block.querySelectorAll(".download-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const el = btn as HTMLElement;
        const copyBtn = el.closest(".flex")?.querySelector(".copy-btn") as HTMLElement | null;
        const body = copyBtn?.dataset.code || "";
        const name = el.dataset.downloadName || "circuit.stim";
        const blob = new Blob([body], { type: "text/plain" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = name;
        a.click();
        URL.revokeObjectURL(url);
        citeNotice();
      });
    });
  });
</script>
