---
import TagList from "./TagList.astro";
import type { Tool } from "../types";

interface Props {
  tool: Tool & { tags: string[]; circuit_count: number; hidden_circuit_count?: number };
  baseUrl?: URL;
}

const { tool, baseUrl } = Astro.props;
const hiddenCount = tool.hidden_circuit_count ?? 0;
---

<div id={tool.slug} class="scroll-mt-4 border border-gray-200 dark:border-gray-800 p-4">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mb-1">
    <h3 class="font-medium">{tool.name}</h3>
    <span class="text-xs text-gray-500 dark:text-gray-400">
      {tool.circuit_count === 0 && hiddenCount === 0
        ? "no circuits yet"
        : `${tool.circuit_count} circuit${tool.circuit_count !== 1 ? "s" : ""}`}{" "}
      {hiddenCount > 0 && (
        <span class="text-gray-400 dark:text-gray-500">(+{hiddenCount} codetables)</span>
      )}
    </span>
    <div class="ml-auto">
      <TagList tags={tool.tags} baseUrl={baseUrl} basePath="/tools" />
    </div>
  </div>

  {tool.description && (
    <p class="text-sm text-gray-600 dark:text-gray-400 mb-1">{tool.description}</p>
  )}

  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
    {tool.homepage_url && (
      <a href={tool.homepage_url} class="underline text-gray-500 hover:text-gray-900 dark:hover:text-gray-100" target="_blank" rel="noopener">
        Homepage &#x2197;
      </a>
    )}
    {tool.github_url && (
      <a href={tool.github_url} class="underline text-gray-500 hover:text-gray-900 dark:hover:text-gray-100" target="_blank" rel="noopener">
        GitHub &#x2197;
      </a>
    )}
    {(tool.paper_urls ?? []).map((url, i) => (
      <a href={url} class="underline text-gray-500 hover:text-gray-900 dark:hover:text-gray-100" target="_blank" rel="noopener">
        {(tool.paper_urls ?? []).length > 1 ? `Paper ${i + 1}` : "Paper"} &#x2197;
      </a>
    ))}
  </div>
</div>
