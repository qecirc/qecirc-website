---
import type { TagWithCount } from "../types";
import TagList from "./TagList.astro";

/**
 * Tag filter block: a "Tags:" label plus category dropdown fields (grouped
 * view) or the flat all-tags cloud, with a persisted toggle between the two.
 * Callers pass the tags pre-grouped; empty groups are skipped here.
 *
 * Selected-state styling, the selected-count badges and the removable chips
 * ([data-tag-chips]) are managed client-side by list-filter-client.ts —
 * KEEP THE CLASS PAIRS THERE IN SYNC with the markup below.
 */
interface Props {
  allTags: TagWithCount[];
  basePath: string;
  groups: { label: string; tags: TagWithCount[] }[];
  defaultView: "grouped" | "all";
  storageKey: string;
}

const { allTags, basePath, groups, defaultView, storageKey } = Astro.props;

const tagUrl = (tag: string) => `${basePath}?tag=${encodeURIComponent(tag)}`;
const tagGroups = groups.filter((g) => g.tags.length > 0);
---

{allTags.length > 0 && (
  <div
    data-tag-filter
    data-storage-key={storageKey}
    data-default-view={defaultView}
    class="flex flex-wrap items-start gap-2"
  >
    <span class="inline-flex items-center gap-1 py-1 text-xs font-medium text-gray-500 dark:text-gray-400" title="Filter by tag">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V5a2 2 0 012-2z" />
      </svg>
      Tags:
    </span>
    <div data-tag-grouped class:list={["flex flex-wrap items-center gap-2", defaultView === "all" && "hidden"]}>
      {tagGroups.map((g) => (
        <details data-tag-dropdown class="relative">
          <summary
            class="flex items-center gap-1.5 rounded px-2.5 py-1 text-xs cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 font-medium"
          >
            {g.label}
            <span data-summary-count></span>
            <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div data-tag-popover class="absolute left-0 top-full mt-1 z-20 min-w-max rounded border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-lg p-1.5 flex flex-col gap-0.5">
            {g.tags.map((t) => (
              <a
                href={tagUrl(t.name)}
                data-tag={t.name}
                class="flex items-center justify-between gap-4 rounded px-2 py-1 text-xs transition-colors text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800"
              >
                {t.name}
                <span class="text-gray-400 dark:text-gray-500">{t.count}</span>
              </a>
            ))}
          </div>
        </details>
      ))}
      <span data-tag-chips class="contents"></span>
      <button type="button" data-tag-view-toggle class="text-xs text-gray-400 dark:text-gray-500 underline hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer">
        all tags
      </button>
    </div>
    <div data-tag-cloud class:list={["min-w-0", defaultView !== "all" && "hidden"]}>
      <TagList tags={allTags} showCount basePath={basePath}>
        <button type="button" data-tag-view-toggle class="text-xs text-gray-400 dark:text-gray-500 underline hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer">
          by category
        </button>
      </TagList>
    </div>
  </div>
)}

<script>
  import { initTagDropdowns } from "../lib/tag-dropdowns-client";

  document.querySelectorAll<HTMLElement>("[data-tag-filter]").forEach(initTagDropdowns);
</script>
