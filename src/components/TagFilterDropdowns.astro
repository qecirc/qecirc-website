---
import type { TagWithCount } from "../types";
import TagList from "./TagList.astro";
import { tagToggleUrl } from "../lib/url";
import {
  TAG_SELECTED,
  DROPDOWN_ENTRY_SELECTED,
  DROPDOWN_ENTRY_UNSELECTED,
  SUMMARY_SELECTED,
  SUMMARY_UNSELECTED,
} from "../lib/constants";

/**
 * Tag filter block: a "Tags:" label plus category dropdown fields (grouped
 * view) or the flat all-tags cloud, with a persisted toggle between the two.
 * Callers pass the tags pre-grouped; empty groups are skipped here.
 *
 * Two modes:
 * - Client-filtered pages (/codes, /codes/[slug]) omit `baseUrl`. Tag links are
 *   static hrefs, and list-filter-client.ts intercepts the clicks and owns the
 *   selected styling, the count badges and the chips.
 * - Server-filtered pages (/search) pass `baseUrl` + `selectedTags`. There is no
 *   list-filter-client, so the links must really navigate (and carry the other
 *   params, e.g. ?q=), and all of that state is rendered here instead.
 */
interface Props {
  allTags: TagWithCount[];
  basePath: string;
  groups: { label: string; tags: TagWithCount[] }[];
  defaultView: "grouped" | "all";
  storageKey: string;
  /** Present => server-filtered mode (see above). */
  baseUrl?: URL;
  selectedTags?: string[];
}

const { allTags, basePath, groups, defaultView, storageKey, baseUrl, selectedTags } = Astro.props;

const serverFiltered = baseUrl != null;
const selected = new Set(selectedTags ?? []);

// Server-filtered links must preserve every other param (?q=, ?code=), which
// tagToggleUrl does and a bare `?tag=` href does not.
const tagUrl = (tag: string) =>
  baseUrl
    ? tagToggleUrl(baseUrl.search, selectedTags ?? [], tag, basePath)
    : `${basePath}?tag=${encodeURIComponent(tag)}`;

const tagGroups = groups.filter((g) => g.tags.length > 0);
const selectedInGroup = (g: { tags: TagWithCount[] }) =>
  g.tags.filter((t) => selected.has(t.name)).length;
---

{allTags.length > 0 && (
  <div
    data-tag-filter
    data-storage-key={storageKey}
    data-default-view={defaultView}
    class="flex flex-wrap items-start gap-2"
  >
    <span class="inline-flex items-center gap-1 py-1 text-xs font-medium text-gray-500 dark:text-gray-400" title="Filter by tag">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V5a2 2 0 012-2z" />
      </svg>
      Tags:
    </span>
    <div data-tag-grouped class:list={["flex flex-wrap items-center gap-2", defaultView === "all" && "hidden"]}>
      {tagGroups.map((g) => {
        const n = selectedInGroup(g);
        return (
          <details data-tag-dropdown class="relative">
            <summary
              class:list={[
                "flex items-center gap-1.5 px-2.5 py-1 text-xs cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors",
                n > 0 ? SUMMARY_SELECTED : SUMMARY_UNSELECTED,
              ]}
            >
              {g.label}
              <span data-summary-count>{n > 0 ? `(${n})` : ""}</span>
              <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div data-tag-popover class="absolute left-0 top-full mt-1 z-20 min-w-max border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-lg p-1.5 flex flex-col gap-0.5">
              {g.tags.map((t) => (
                <a
                  href={tagUrl(t.name)}
                  data-tag={t.name}
                  class:list={[
                    "flex items-center justify-between gap-4 px-2 py-1 text-xs transition-colors",
                    selected.has(t.name) ? DROPDOWN_ENTRY_SELECTED : DROPDOWN_ENTRY_UNSELECTED,
                  ]}
                >
                  {t.name}
                  <span class:list={[selected.has(t.name) ? "opacity-70" : "text-gray-500 dark:text-gray-400"]}>{t.count}</span>
                </a>
              ))}
            </div>
          </details>
        );
      })}
      {/* Selected tags, surfaced outside the dropdowns so a selection made in a
          now-collapsed group stays visible. list-filter-client fills this in on
          client-filtered pages; server-filtered ones must render it. */}
      <span data-tag-chips class="contents">
        {serverFiltered && (selectedTags ?? []).map((tag) => (
          <a
            href={tagUrl(tag)}
            data-tag={tag}
            title={`Remove tag filter "${tag}"`}
            class:list={["inline-flex items-center gap-1 px-2 py-0.5 text-xs transition-colors", TAG_SELECTED]}
          >
            {tag}
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 18L18 6M6 6l12 12" />
            </svg>
          </a>
        ))}
      </span>
      <button type="button" data-tag-view-toggle class="text-xs text-gray-500 dark:text-gray-400 underline hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer">
        all tags
      </button>
    </div>
    <div data-tag-cloud class:list={["min-w-0", defaultView !== "all" && "hidden"]}>
      <TagList tags={allTags} showCount basePath={basePath} baseUrl={baseUrl} selectedTags={selectedTags}>
        <button type="button" data-tag-view-toggle class="text-xs text-gray-500 dark:text-gray-400 underline hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer">
          by category
        </button>
      </TagList>
    </div>
  </div>
)}

<script>
  import { initTagDropdowns } from "../lib/tag-dropdowns-client";

  document.querySelectorAll<HTMLElement>("[data-tag-filter]").forEach(initTagDropdowns);
</script>
