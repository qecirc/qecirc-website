---
import type { Circuit, Tool } from "../types";
import { formatCircuitId } from "../lib/queries";
import { buildStimFilename } from "../lib/filename";
import HeartIcon from "./HeartIcon.astro";
import MetricBadge from "./MetricBadge.astro";

interface Props {
  circuit: Circuit & { tags: string[] };
  tool?: Tool;
  codeSlug: string;
  /** Shown next to the name on cross-code lists (/search), where the row would
   *  otherwise not say which code it belongs to. Omitted on code pages, where
   *  the whole page is already one code. */
  codeLabel?: string;
  /** Where a tag chip links. Defaults to filtering this circuit's code page.
   *  /search overrides it so a tag toggles the search's own tag filter. */
  tagHrefFor?: (tag: string) => string;
  /** What the id button copies. Defaults to this page + #id, which is right on
   *  a code page. /search must override it: a /search#id link drops the ?q= and
   *  would resolve to a page that never renders that row. */
  permalinkPath?: string;
}

const { circuit, tool, codeSlug, codeLabel, tagHrefFor, permalinkPath } = Astro.props;

const basePath = `/codes/${codeSlug}`;
const tagHref = tagHrefFor ?? ((tag: string) => `${basePath}?tag=${encodeURIComponent(tag)}`);
const displayId = formatCircuitId(circuit.qec_id);

// Row data consumed by list-filter-client.ts (client-side filtering/sorting).
const rowMetrics = JSON.stringify({
  gate_count: circuit.gate_count,
  two_qubit_gate_count: circuit.two_qubit_gate_count,
  depth: circuit.depth,
  qubit_count: circuit.qubit_count,
  weight: circuit.weight ?? null,
});
const rowTags = JSON.stringify(circuit.tags);
const anchorId = String(circuit.qec_id);

const stimFilename = buildStimFilename({
  codeSlug: codeSlug,
  circuitSlug: circuit.slug,
  gateCount: circuit.gate_count,
  twoQubitGateCount: circuit.two_qubit_gate_count,
  depth: circuit.depth,
  qubitCount: circuit.qubit_count,
});
---

<div
  id={anchorId}
  class="rounded border border-gray-200 dark:border-gray-800"
  data-filter-row
  data-name={circuit.name}
  data-metrics={rowMetrics}
  data-tags={rowTags}
>
  <div
    class="circuit-toggle w-full text-left px-4 py-3 grid items-center gap-x-1.5 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/40 focus-visible:ring-inset"
    style="grid-template-columns: var(--circuit-grid);"
    role="button"
    tabindex="0"
    data-qec-id={anchorId}
    aria-expanded="false"
    data-list-row
  >
    <svg
      class="chevron w-4 h-4 shrink-0 text-gray-400 transition-transform duration-200"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M9 5l7 7-7 7" />
    </svg>

    <button
      class="circuit-permalink text-gray-500 dark:text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 font-mono text-xs shrink-0 cursor-pointer"
      aria-label="Copy link to circuit"
      title="Copy link"
      data-qec-id={anchorId}
      data-permalink-path={permalinkPath}
    >
      <span class="permalink-label">{displayId}</span>
      <svg class="permalink-check w-3.5 h-3.5 hidden text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 6L9 17l-5-5" />
      </svg>
    </button>

    <button
      class="circuit-fav text-gray-300 dark:text-gray-600 hover:text-red-400 dark:hover:text-red-400 cursor-pointer shrink-0"
      data-qec-id={anchorId}
      aria-label="Toggle favorite"
      title="Toggle favorite"
      data-list-fav
    >
      <HeartIcon class="fav-outline w-3.5 h-3.5" />
      <HeartIcon filled class="fav-filled w-3.5 h-3.5 hidden" />
    </button>

    {/* `md:contents` dissolves this wrapper above md, so the four spans go back
        to being grid items in their own columns and the desktop row is
        unchanged. Below md the wrapper is one item on a line of its own
        (order-1) carrying the labels the desktop column headers supply.
        col-start-4 is the name's column, so the metrics line up under the name
        without hard-coding the width of the three columns before it.
        See --circuit-grid in global.css. */}
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 col-start-4 order-1 mt-1.5 md:contents">
      <span class="text-center">
        <MetricBadge value={circuit.gate_count} label="G:" labelClass="md:hidden" title="Gate count" />
      </span>
      <span class="text-center">
        <MetricBadge value={circuit.two_qubit_gate_count} label="2Q:" labelClass="md:hidden" title="Two-qubit gate count" />
      </span>
      <span class="text-center">
        <MetricBadge value={circuit.depth} label="D:" labelClass="md:hidden" title="Circuit depth" />
      </span>
      <span class="text-center">
        <MetricBadge value={circuit.qubit_count} label="Q:" labelClass="md:hidden" title="Qubit count" />
      </span>
    </div>

    <span class="hidden md:block"></span>
    <div class="flex items-baseline gap-2 min-w-0">
      <a href={`/circuits/${circuit.qec_id}`} class="circuit-detail-link font-medium text-sm hover:underline inline-flex items-baseline gap-1 w-fit max-w-full min-w-0" data-list-detail-link>
        <span class="truncate">{circuit.name}</span>
        <svg class="w-3 h-3 shrink-0 self-center text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 5l7 7-7 7" />
        </svg>
      </a>
      {codeLabel && (
        <a href={basePath} class="circuit-code-link text-xs text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 truncate shrink-0">
          {codeLabel}
        </a>
      )}
    </div>

    {circuit.tags.length > 0 && (
      <div class="flex flex-wrap gap-1 justify-end col-span-full order-2 mt-1.5 md:col-auto md:order-none md:mt-0 md:justify-self-end">
        {circuit.tags.map((tag) => (
          <a
            href={tagHref(tag)}
            data-tag={tag}
            class="circuit-tag inline-block rounded px-1.5 py-0.5 text-xs transition-colors bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- data-circuit-scope: the Detectors switch lives in the format-tab row but
       repoints the Crumble link above it, so they need a common ancestor. -->
  <div class="circuit-detail overflow-hidden transition-[max-height] duration-300 ease-in-out" style="max-height: 0px;" data-circuit-scope>
    <div class="border-t border-gray-200 dark:border-gray-800 px-4 py-4 space-y-3">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-1 text-sm">
        <div>
          <span class="text-gray-500 dark:text-gray-400">ID:</span>{" "}
          <button
            class="circuit-id-copy font-mono text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 cursor-pointer"
            title="Copy circuit ID"
            data-qec-id={anchorId}
          >
            <span class="id-label">{displayId}</span>
            <svg class="id-check w-3.5 h-3.5 hidden text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 6L9 17l-5-5" />
            </svg>
          </button>
        </div>
        <div>
          <span class="text-gray-500 dark:text-gray-400">Source:</span>{" "}
          {circuit.source.startsWith("http") ? (
            <a href={circuit.source} class="underline hover:text-gray-900 dark:hover:text-gray-100" target="_blank" rel="noopener">
              {circuit.source}
            </a>
          ) : (
            <span>{circuit.source}</span>
          )}
        </div>
        {tool && (
          <div>
            <span class="text-gray-500 dark:text-gray-400">Tool:</span>{" "}
            <a href={`/tools#${tool.slug}`} class="underline hover:text-gray-900 dark:hover:text-gray-100">
              {tool.name}
            </a>
          </div>
        )}
        {(circuit.crumble_url || circuit.quirk_url) && (
          <div class="flex items-center gap-3">
            <span class="text-gray-500 dark:text-gray-400">View in:</span>
            {circuit.crumble_url && (
              <a
                href={circuit.crumble_url}
                class="underline hover:text-gray-900 dark:hover:text-gray-100"
                target="_blank"
                rel="noopener"
                data-crumble-link
                data-crumble-url={circuit.crumble_url}
                data-crumble-url-annotated={circuit.crumble_url_annotated ?? undefined}
              >
                Crumble &#x2197;
              </a>
            )}
            {circuit.quirk_url && (
              <a href={circuit.quirk_url} class="underline hover:text-gray-900 dark:hover:text-gray-100" target="_blank" rel="noopener">
                Quirk &#x2197;
              </a>
            )}
          </div>
        )}
      </div>

      {circuit.notes && (
        <div class="notes-wrapper">
          {/* break-words: 311 of the 756 circuits with notes cite a source path
              of 100+ characters and no spaces, which `normal` overflow-wrap has
              nowhere to break -- it runs straight out of the column. */}
          <p class="notes-text text-sm text-gray-600 dark:text-gray-400 whitespace-pre-line break-words line-clamp-1">{circuit.notes}</p>
          <button
            class="notes-toggle text-xs text-gray-500 dark:text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer mt-0.5 hidden"
            type="button"
          >
            Show more
          </button>
        </div>
      )}

      <div
        class="circuit-bodies"
        data-qec-id={anchorId}
        data-stim-filename={stimFilename}
        data-source={circuit.source}
      >
        <p class="circuit-bodies-status text-sm text-gray-500 dark:text-gray-400">Loading circuit&hellip;</p>
      </div>
    </div>
  </div>
</div>

<script>
  import { copyToClipboard, setFavState } from "../lib/dom-helpers";

  function initCircuitRows() {
    document.querySelectorAll(".circuit-toggle").forEach(function (btn) {
      if ((btn as HTMLElement).dataset.initialized) return;
      (btn as HTMLElement).dataset.initialized = "1";

      btn.addEventListener("click", function (e) {
        if ((e.target as HTMLElement).closest(".circuit-tag")) return;
        if ((e.target as HTMLElement).closest(".circuit-code-link")) return;
        if ((e.target as HTMLElement).closest(".circuit-permalink")) return;
        if ((e.target as HTMLElement).closest(".circuit-id-copy")) return;
        if ((e.target as HTMLElement).closest(".circuit-detail-link")) return;
        if ((e.target as HTMLElement).closest(".circuit-fav")) return;
        const qecId = (btn as HTMLElement).dataset.qecId!;
        const row = btn.closest("[id]") as HTMLElement;
        const detail = row.querySelector(".circuit-detail") as HTMLElement;
        const chevron = btn.querySelector(".chevron") as HTMLElement;
        const isOpen = detail.style.maxHeight !== "0px";

        if (isOpen) {
          detail.style.maxHeight = "0px";
          chevron.classList.remove("rotate-90");
          btn.setAttribute("aria-expanded", "false");
          if (location.hash === "#" + qecId) {
            history.replaceState(null, "", location.pathname + location.search);
          }
        } else {
          // Close any other open rows
          document.querySelectorAll(".circuit-detail").forEach(function (d) {
            if (d !== detail) {
              (d as HTMLElement).style.maxHeight = "0px";
              const otherBtn = (d as HTMLElement).closest("[id]")?.querySelector(".circuit-toggle");
              if (otherBtn) {
                otherBtn.querySelector(".chevron")?.classList.remove("rotate-90");
                otherBtn.setAttribute("aria-expanded", "false");
              }
            }
          });
          detail.style.maxHeight = detail.scrollHeight + "px";
          chevron.classList.add("rotate-90");
          btn.setAttribute("aria-expanded", "true");
          history.replaceState(null, "", "#" + qecId);
          // Signal circuit-bodies-client (code pages) to lazy-load bodies.
          detail.dispatchEvent(new CustomEvent("circuit-expand", { bubbles: true }));

          // Notes toggle: check overflow after first expand
          const notesText = detail.querySelector(".notes-text") as HTMLElement;
          const notesToggle = detail.querySelector(".notes-toggle") as HTMLButtonElement;
          if (notesText && notesToggle && !notesToggle.dataset.initialized) {
            notesToggle.dataset.initialized = "1";
            requestAnimationFrame(function () {
              if (notesText.scrollHeight > notesText.clientHeight) {
                notesToggle.classList.remove("hidden");
              }
            });
            notesToggle.addEventListener("click", function () {
              const isClamped = notesText.classList.contains("line-clamp-1");
              notesText.classList.toggle("line-clamp-1");
              notesToggle.textContent = isClamped ? "Show less" : "Show more";
              requestAnimationFrame(function () {
                detail.style.maxHeight = detail.scrollHeight + "px";
              });
            });
          }
        }
      });
    });
  }

  function expandFromHash() {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const target = document.getElementById(hash);
    if (!target) return;
    const btn = target.querySelector(".circuit-toggle") as HTMLElement;
    if (btn && btn.getAttribute("aria-expanded") !== "true") {
      btn.click();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  }

  function showCopyCheck(btn: HTMLElement, labelSel: string, checkSel: string) {
    const label = btn.querySelector(labelSel) as HTMLElement;
    const check = btn.querySelector(checkSel) as HTMLElement;
    label.classList.add("hidden");
    check.classList.remove("hidden");
    clearTimeout(Number(btn.dataset.timer));
    btn.dataset.timer = String(setTimeout(function () {
      label.classList.remove("hidden");
      check.classList.add("hidden");
    }, 1500));
  }

  function initPermalinks() {
    document.querySelectorAll<HTMLButtonElement>(".circuit-permalink").forEach(function (btn) {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = "1";

      btn.addEventListener("click", async function () {
        const qecId = btn.dataset.qecId;
        // data-permalink-path is set on cross-code lists, where "this page +
        // #id" would not resolve back to this row (see the prop's doc).
        const url = btn.dataset.permalinkPath
          ? location.origin + btn.dataset.permalinkPath
          : location.origin + location.pathname + "#" + qecId;
        const ok = await copyToClipboard(url);
        if (!ok) return;
        showCopyCheck(btn, ".permalink-label", ".permalink-check");
      });
    });
  }

  function initIdCopy() {
    document.querySelectorAll<HTMLButtonElement>(".circuit-id-copy").forEach(function (btn) {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = "1";

      btn.addEventListener("click", async function () {
        const qecId = btn.dataset.qecId;
        const ok = await copyToClipboard("#" + qecId);
        if (!ok) return;
        showCopyCheck(btn, ".id-label", ".id-check");
      });
    });
  }

  function initFavorites() {
    import("../lib/favorites-client").then(function ({ getFavorites, toggleFavorite }) {
      const favSet = new Set(getFavorites());
      document.querySelectorAll<HTMLButtonElement>(".circuit-fav").forEach(function (btn) {
        if (btn.dataset.favInit) return;
        btn.dataset.favInit = "1";

        const qecId = Number(btn.dataset.qecId);

        if (favSet.has(qecId)) {
          setFavState(btn, true);
        }

        btn.addEventListener("click", function () {
          setFavState(btn, toggleFavorite(qecId));
        });
      });
    });
  }

  initCircuitRows();
  initPermalinks();
  initIdCopy();
  initFavorites();
  expandFromHash();
  window.addEventListener("hashchange", expandFromHash);
</script>
