---
export const prerender = false;

import Layout from "../components/Layout.astro";
import CodeCard from "../components/CodeCard.astro";
import CodeFilter from "../components/CodeFilter.astro";
import { filterCodes, countAllCodes, hasActiveFilters, getTagsWithCount } from "../lib/queries";
import { parseCodeParams, codeSortToggleUrl } from "../lib/url";
import type { CodeSortField } from "../types";

const { raw, errors, tags: selectedTags, focus: focusField, filters, sort } = parseCodeParams(Astro.url);

const allTags = getTagsWithCount("code");
const active = hasActiveFilters(filters);
const codes = filterCodes(filters, sort);
const totalCount = active ? countAllCodes() : codes.length;

const sortHref = (field: CodeSortField) => codeSortToggleUrl(Astro.url, sort, field, "/");
---

<Layout title="Codes" description="Browse quantum error correction codes and circuits">
  <h1 class="text-2xl font-bold mb-6">Codes</h1>

  <CodeFilter
    rawN={raw.n} rawK={raw.k} rawD={raw.d}
    errors={errors} hasFilters={active} focus={focusField}
    allTags={allTags} selectedTags={selectedTags}
    currentUrl={Astro.url}
  />

  <p class="text-sm text-gray-500 mb-4">
    {active
      ? `Showing ${codes.length} of ${totalCount} codes`
      : `${totalCount} ${totalCount === 1 ? "code" : "codes"}`}
  </p>

  {codes.length === 0 ? (
    <p class="text-gray-500">No codes match the current filters.</p>
  ) : (
    <div>
      <div class="flex items-baseline gap-3 mb-3 px-4 text-[11px] font-bold tracking-wider uppercase text-gray-500 dark:text-gray-400">
        <span>Sort by:</span>
        <a href={sortHref("n")} class:list={["hover:text-gray-900 dark:hover:text-gray-100", sort.field === "n" && "text-amber-600 dark:text-amber-400"]} title="Physical qubits — click to sort">N</a>
        <a href={sortHref("k")} class:list={["hover:text-gray-900 dark:hover:text-gray-100", sort.field === "k" && "text-amber-600 dark:text-amber-400"]} title="Logical qubits — click to sort">K</a>
        <a href={sortHref("d")} class:list={["hover:text-gray-900 dark:hover:text-gray-100", sort.field === "d" && "text-amber-600 dark:text-amber-400"]} title="Code distance — click to sort">D</a>
      </div>
      <div class="grid gap-4">
        {codes.map((code) => (
          <CodeCard code={code} baseUrl={Astro.url} />
        ))}
      </div>
    </div>
  )}
</Layout>

<script>
  import { initListKeynav } from "../lib/list-keynav-client";

  initListKeynav({
    rowSelector: "[data-list-row]",
    enterSelector: "[data-list-link]",
  });
</script>
