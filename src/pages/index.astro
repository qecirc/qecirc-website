---
// SSR, deliberately NOT prerendered. @astrojs/node serves prerendered pages
// from disk without running middleware, so a static `/` would silently lose the
// s-maxage=604800 edge caching every other page gets (see src/middleware.ts and
// src/lib/cache-purge.ts). The DB is baked at build time either way, so there is
// nothing to gain from prerendering and a cache to lose. The redirect below
// also depends on this running per-request.
export const prerender = false;

import Layout from "../components/Layout.astro";
import {
  countAllCodes,
  countAllCircuits,
  countAllTools,
  countCircuitPapers,
  getLatestCircuits,
  formatCircuitId,
} from "../lib/queries";
import { CONTRIBUTORS } from "../lib/contributors";

// `/` was the codes list until v0.5.0, and client-side filtering pushed history
// entries like /?n=>3 and /?tag=CSS. Forward those rather than silently
// dropping the filter on the landing page.
const CODES_LIST_PARAMS = ["tag", "n", "k", "d", "sort", "sort_dir"];
if (CODES_LIST_PARAMS.some((p) => Astro.url.searchParams.has(p))) {
  return Astro.redirect(`/codes${Astro.url.search}`, 301);
}

const fmt = new Intl.NumberFormat("en-US");
const codeCount = countAllCodes();
const circuitCount = countAllCircuits();

// Deliberately not linked, unlike the cards below: "papers" has no page to go
// to, and a row where only some numbers are clickable reads as broken.
const STATS: { value: number; label: string }[] = [
  { value: circuitCount, label: "Circuits" },
  { value: codeCount, label: "Codes" },
  { value: countAllTools(), label: "Tools" },
  { value: countCircuitPapers(), label: "Papers" },
  { value: CONTRIBUTORS.length, label: "Contributors" },
];

const latest = getLatestCircuits(5);

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${siteUrl}/#landing`,
  url: `${siteUrl}/`,
  name: "QECirc",
  description: "A community-driven library for quantum error correction circuits.",
  isPartOf: { "@id": `${siteUrl}/#website` },
};

const cardCls =
  "rounded border border-gray-200 dark:border-gray-800 p-4 hover:border-gray-400 dark:hover:border-gray-600 transition-colors";
---

<Layout
  title="Quantum error correction circuits"
  description="A community-driven library of quantum error correction circuits — browse, search and download STIM, QASM and Cirq circuits by code."
  jsonLd={jsonLd}
>
  <section class="max-w-2xl mb-8">
    <h1 class="text-3xl font-bold mb-3">Quantum error correction circuits</h1>
    {/* Circuit types named here are the ones that actually exist: state
        preparation, flag gadgets and encoding. The corpus has no
        syndrome-extraction circuits yet, so the hero does not promise any. */}
    <p class="text-gray-600 dark:text-gray-400 mb-3">
      Find, compare and download reusable QEC circuits — state preparation, flag gadgets
      and encoding — organised by error-correcting code. Every circuit comes with its
      metrics and its source, stored in STIM and offered as QASM and Cirq.
    </p>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      QECirc is built as a community project, in the open. The circuits are drawn from
      published work and from the tools that generate them, and anyone can add one by{" "}
      <a href="/contribute" class="prose-link">opening an issue on GitHub</a>. See{" "}
      <a href="/about" class="prose-link">about</a> for the scope and how it fits
      together.
    </p>

  </section>

  {/* Search gets the same border language as the cards below, but full width and
      tinted: it is the primary action, so it should read as more than a fourth
      card. Not a link, so no hover treatment. */}
  <section class="mb-10">
    <div class="rounded border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-4 sm:p-6">
      <h2 class="text-lg font-semibold mb-1">Find circuits</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
        Search all {fmt.format(circuitCount)} circuits by name, notes, tag or code, ranked
        by relevance.
      </p>
      <form method="GET" action="/search" class="flex gap-2">
        <input
          type="search"
          name="q"
          placeholder="Search circuits by name, notes, tag or #id"
          aria-label="Search circuits"
          class="flex-1 rounded border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40"
        />
        <button
          type="submit"
          class="rounded px-4 py-2 text-sm font-medium bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 hover:bg-gray-700 dark:hover:bg-gray-300 cursor-pointer"
        >
          Search
        </button>
      </form>
    </div>
  </section>

  <section class="mb-10" aria-label="Library at a glance">
    {/* Fixed columns rather than flex-wrap: with five stats, wrapping strands
        the last one alone on its own row at narrow widths. */}
    <dl class="grid grid-cols-3 gap-x-6 gap-y-6 sm:grid-cols-5 sm:gap-x-8">
      {STATS.map((s) => (
        <div>
          <dd class="text-2xl font-bold tabular-nums">{fmt.format(s.value)}</dd>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">{s.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <section class="grid gap-4 sm:grid-cols-3 mb-10">
    <a href="/codes" class={cardCls}>
      <h2 class="font-medium mb-1">Browse codes &#8594;</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        All {fmt.format(codeCount)} codes, filterable by [[n,k,d]] and tags.
      </p>
    </a>
    <a href="/tools" class={cardCls}>
      <h2 class="font-medium mb-1">Tools &#8594;</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        The software used to synthesise these circuits.
      </p>
    </a>
    <a href="/contribute" class={cardCls}>
      <h2 class="font-medium mb-1">Contribute &#8594;</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        Add a circuit or import a dataset.
      </p>
    </a>
  </section>

  {latest.length > 0 && (
    <section>
      <h2 class="text-lg font-semibold mb-3">Latest circuits</h2>
      <div class="grid gap-2">
        {latest.map((circuit) => (
          <a
            href={`/circuits/${circuit.qec_id}`}
            class="rounded border border-gray-200 dark:border-gray-800 px-4 py-2.5 flex items-baseline gap-2 flex-wrap hover:border-gray-400 dark:hover:border-gray-600 transition-colors"
          >
            <span class="font-mono text-xs text-gray-400 dark:text-gray-500">{formatCircuitId(circuit.qec_id)}</span>
            <span class="font-medium text-sm">{circuit.name}</span>
            <span class="text-sm text-gray-500 dark:text-gray-400">{circuit.code_name}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
