---
// SSR, deliberately NOT prerendered. @astrojs/node serves prerendered pages
// from disk without running middleware, so a static `/` would silently lose the
// s-maxage=604800 edge caching every other page gets (see src/middleware.ts and
// src/lib/cache-purge.ts). The DB is baked at build time either way, so there is
// nothing to gain from prerendering and a cache to lose. The redirect below
// also depends on this running per-request.
export const prerender = false;

import Layout from "../components/Layout.astro";
import TagList from "../components/TagList.astro";
import ToolCard from "../components/ToolCard.astro";
import {
  countAllCodes,
  countAllCircuits,
  countAllTools,
  countCircuitPapers,
  getLatestCircuits,
  getTagsWithCount,
  getAllTools,
  formatCircuitId,
} from "../lib/queries";
import { CONTRIBUTORS } from "../lib/contributors";

// `/` was the codes list until v0.5.0, and client-side filtering pushed history
// entries like /?n=>3 and /?tag=CSS. Forward those rather than silently
// dropping the filter on the landing page.
const CODES_LIST_PARAMS = ["tag", "n", "k", "d", "sort", "sort_dir"];
if (CODES_LIST_PARAMS.some((p) => Astro.url.searchParams.has(p))) {
  return Astro.redirect(`/codes${Astro.url.search}`, 301);
}

const fmt = new Intl.NumberFormat("en-US");
const codeCount = countAllCodes();
const circuitCount = countAllCircuits();

// Deliberately not linked, unlike the cards below: "papers" has no page to go
// to, and a row where only some numbers are clickable reads as broken.
const STATS: { value: number; label: string }[] = [
  { value: circuitCount, label: "Circuits" },
  { value: codeCount, label: "Codes" },
  { value: countAllTools(), label: "Tools" },
  { value: countCircuitPapers(), label: "Papers" },
  { value: CONTRIBUTORS.length, label: "Contributors" },
];

const latest = getLatestCircuits(5);

// Illustrations for the "What you can do" panels below. Both are queried, not
// listed by hand: a hardcoded tag would outlive the tag itself, and a hardcoded
// tool would go stale the moment /tools grows.
// getTagsWithCount sorts by name, not count, so re-sort before slicing --
// otherwise this shows whatever happens to sort first, not what most codes are.
const EXAMPLE_CODE_TAGS = getTagsWithCount("code")
  .toSorted((a, b) => b.count - a.count)
  .slice(0, 6)
  .map((t) => t.name);

// The three fields CodeFilter renders, with its own placeholder text as the
// example -- so this shows the real filter syntax, not an invented one. `n`
// carries the amber active-sort styling because sorting by n ascending is
// CodeFilter's true default (DEFAULT_SORT_FIELD).
const FILTER_EXAMPLES: { field: string; example: string; sorted: boolean }[] = [
  { field: "n", example: ">3,<10", sorted: true },
  { field: "k", example: ">=2", sorted: false },
  { field: "d", example: "!=5", sorted: false },
];
// getAllTools sorts by circuit count, so [0] is the most productive tool.
// Tools with no circuits yet are real (/tools lists them) but make a poor
// preview: this step is about reaching the software behind a circuit.
// Undefined only if the tools table is empty, hence the guard at the usage.
const EXAMPLE_TOOL = getAllTools().find((t) => t.circuit_count > 0);

const CONTRIBUTE_STEPS = [
  "You open an issue with the circuit and where it came from",
  "A maintainer checks it and runs the ingestion pipeline",
  "It appears in the library, credited to its source",
];

const cardCls =
  "rounded border border-gray-200 dark:border-gray-800 p-4 hover:border-gray-400 dark:hover:border-gray-600 transition-colors";
const stepCls =
  "rounded border border-gray-200 dark:border-gray-800 p-4 grid gap-4 sm:grid-cols-2 sm:items-start";
const stepTitleCls = "font-medium mb-1 flex items-baseline gap-2";
const stepNumCls = "font-mono text-xs text-gray-400 dark:text-gray-500";
const previewLabelCls =
  "text-[11px] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500 mb-1.5";

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${siteUrl}/#landing`,
  url: `${siteUrl}/`,
  name: "QECirc",
  description: "A community-driven library for quantum error correction circuits.",
  isPartOf: { "@id": `${siteUrl}/#website` },
};

---

<Layout
  title="Quantum error correction circuits"
  description="Find the QEC circuits you need to design fault-tolerant computation. Browse, search and download STIM, QASM and Cirq circuits, organised by error-correcting code."
  jsonLd={jsonLd}
>
  <section class="max-w-2xl mb-8">
    <h1 class="text-3xl font-bold mb-3">Quantum error correction circuits</h1>
    {/* Encoding, state preparation and flag gadgets are what the library
        actually holds; syndrome extraction is named as scope, so it says "still
        to come" rather than implying you can download one today. */}
    <p class="text-gray-600 dark:text-gray-400 mb-3">
      QECirc is where QEC researchers find the circuits they need to design
      fault-tolerant computation. Browse, compare and download reusable circuits for
      encoding, state preparation and flag gadgets, organised by error-correcting code,
      with syndrome extraction still to come. Each circuit carries its metrics and its
      source, stored in STIM and offered as QASM and Cirq.
    </p>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      QECirc is built as a community project, in the open. The circuits are drawn from
      published work and from the tools that generate them, and anyone can add one by{" "}
      <a href="/contribute" class="prose-link">opening an issue on GitHub</a>. See{" "}
      <a href="/about" class="prose-link">about</a> for the scope and how it fits
      together.
    </p>

  </section>

  {/* Search gets the same border language as the cards below, but full width and
      tinted: it is the primary action, so it should read as more than a fourth
      card. Not a link, so no hover treatment. */}
  <section class="mb-10">
    <div class="rounded border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 p-4 sm:p-6">
      <h2 class="text-lg font-semibold mb-1">Find circuits</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
        Search all {fmt.format(circuitCount)} circuits by name, notes, tag or code, ranked
        by relevance.
      </p>
      <form method="GET" action="/search" class="flex gap-2">
        <input
          type="search"
          name="q"
          placeholder="Search circuits by name, notes, tag or #id"
          aria-label="Search circuits"
          class="flex-1 rounded border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-950 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/40"
        />
        <button
          type="submit"
          class="rounded px-4 py-2 text-sm font-medium bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 hover:bg-gray-700 dark:hover:bg-gray-300 cursor-pointer"
        >
          Search
        </button>
      </form>
    </div>
  </section>

  <section class="mb-10" aria-label="Library at a glance">
    {/* Fixed columns rather than flex-wrap: with five stats, wrapping strands
        the last one alone on its own row at narrow widths. */}
    <dl class="grid grid-cols-3 gap-x-6 gap-y-6 sm:grid-cols-5 sm:gap-x-8">
      {STATS.map((s) => (
        <div>
          <dd class="text-2xl font-bold tabular-nums">{fmt.format(s.value)}</dd>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">{s.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <section class="grid gap-4 sm:grid-cols-3 mb-10">
    <a href="/codes" class={cardCls}>
      <h2 class="font-medium mb-1">Browse codes &#8594;</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        All {fmt.format(codeCount)} codes, filterable by [[n,k,d]] and tags.
      </p>
    </a>
    <a href="/tools" class={cardCls}>
      <h2 class="font-medium mb-1">Tools &#8594;</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        The software used to synthesise these circuits.
      </p>
    </a>
    <a href="/contribute" class={cardCls}>
      <h2 class="font-medium mb-1">Contribute &#8594;</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        Add a circuit or import a dataset.
      </p>
    </a>
  </section>

  {/* Expands the three cards above into what each one actually does. The
      previews are built from the site's own live components and queries rather
      than screenshots: the site is alpha and changes without notice, so an
      image would rot silently with nothing in CI to catch it, would need a
      second copy for dark mode, and could not be clicked. These cannot drift --
      restyle a tag and this restyles with it. */}
  <section class="mb-10">
    <h2 class="text-lg font-semibold mb-1">How QECirc works</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
      Three parts, and how they fit together. The examples are live, so you can click
      straight through.
    </p>

    <div class="space-y-3">
      <div class={stepCls}>
        <div>
          <h3 class={stepTitleCls}>
            <span class={stepNumCls}>1</span>Browse codes to find circuits
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
            Every circuit belongs to a code, so start there. Narrow {fmt.format(codeCount)} codes
            by any of [[n,k,d]] at once, or by family; click a parameter to sort on it instead.
            Open a code to see its circuits with gate count, depth and qubit count.
          </p>
          <a href="/codes" class="text-sm font-medium prose-link">Browse codes &#8594;</a>
        </div>
        <div class="min-w-0">
          <p class={previewLabelCls}>Filter by parameter</p>
          {/* A replica of CodeFilter's control, not the control itself:
              CodeFilter renders a form that list-filter-client binds to by id,
              and a second one here would fight the real one for the same
              clicks. Each box links to the filter it shows, so the example is
              also the way in. */}
          <div class="flex flex-wrap gap-1.5">
            {FILTER_EXAMPLES.map(({ field, example, sorted }) => (
              <a
                href={`/codes?${field}=${encodeURIComponent(example)}`}
                class="inline-flex items-center gap-1 rounded border border-gray-300 dark:border-gray-700 px-1.5 py-0.5 hover:border-gray-400 dark:hover:border-gray-600 transition-colors"
                title={`Filter codes by ${field} ${example}`}
              >
                <span
                  class:list={[
                    "px-1 py-0.5 text-xs font-semibold",
                    sorted
                      ? "text-amber-600 dark:text-amber-400"
                      : "text-gray-600 dark:text-gray-400",
                  ]}
                >
                  {field}
                  {sorted && <span class="ml-0.5 text-[10px] text-gray-500">&#9650;</span>}
                </span>
                <span class="px-1 py-0.5 text-sm font-mono text-gray-500 dark:text-gray-400">
                  {example}
                </span>
              </a>
            ))}
          </div>
          <p class={`${previewLabelCls} mt-3`}>Or by family</p>
          <TagList tags={EXAMPLE_CODE_TAGS} basePath="/codes" />
        </div>
      </div>

      <div class={stepCls}>
        <div>
          <h3 class={stepTitleCls}>
            <span class={stepNumCls}>2</span>Browse tools to synthesise your own
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
            Most circuits here were generated rather than written by hand. Every tool lists its
            paper and repository, and its circuits carry a{" "}
            <span class="font-mono text-xs">tool:</span>{" "}tag, so you can go from a circuit you
            like to the software that produced it.
          </p>
          <a href="/tools" class="text-sm font-medium prose-link">
            All {fmt.format(countAllTools())} tools &#8594;
          </a>
        </div>
        <div class="min-w-0">
          <p class={previewLabelCls}>A tool entry</p>
          {/* The real ToolCard /tools renders, on real data -- so this preview
              is the page, not a picture of it. */}
          {EXAMPLE_TOOL && <ToolCard tool={EXAMPLE_TOOL} />}
        </div>
      </div>

      <div class={stepCls}>
        <div>
          <h3 class={stepTitleCls}>
            <span class={stepNumCls}>3</span>Contribute what you have
          </h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">
            Found a circuit in a paper, or built one yourself? Open an issue with the STIM body
            and its source. A maintainer reviews it and runs the ingestion, so you do not need
            to touch the repository. Whole datasets are welcome too.
          </p>
          <a href="/contribute" class="text-sm font-medium prose-link">How to contribute &#8594;</a>
        </div>
        <div class="min-w-0">
          <p class={previewLabelCls}>What happens next</p>
          <ol class="text-sm text-gray-500 dark:text-gray-400 space-y-1">
            {CONTRIBUTE_STEPS.map((s, i) => (
              <li class="flex gap-2">
                <span class="font-mono text-xs text-gray-400 dark:text-gray-500 pt-0.5">{i + 1}</span>
                <span>{s}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  {latest.length > 0 && (
    <section>
      <h2 class="text-lg font-semibold mb-3">Latest circuits</h2>
      <div class="grid gap-2">
        {latest.map((circuit) => (
          <a
            href={`/circuits/${circuit.qec_id}`}
            class="rounded border border-gray-200 dark:border-gray-800 px-4 py-2.5 flex items-baseline gap-2 flex-wrap hover:border-gray-400 dark:hover:border-gray-600 transition-colors"
          >
            <span class="font-mono text-xs text-gray-400 dark:text-gray-500">{formatCircuitId(circuit.qec_id)}</span>
            <span class="font-medium text-sm">{circuit.name}</span>
            <span class="text-sm text-gray-500 dark:text-gray-400">{circuit.code_name}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
