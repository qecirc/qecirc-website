---
export const prerender = false;

import Layout from "../../components/Layout.astro";
import TagList from "../../components/TagList.astro";
import CircuitFilter from "../../components/CircuitFilter.astro";
import CircuitRow from "../../components/CircuitRow.astro";
import CircuitBodiesTemplate from "../../components/CircuitBodiesTemplate.astro";
import CodeMatrices from "../../components/CodeMatrices.astro";
import CollapsibleSection from "../../components/CollapsibleSection.astro";
import HeartIcon from "../../components/HeartIcon.astro";
import {
  getCodeBySlug,
  getTagsFor,
  formatCodeParams,
  codeHasWeightedCircuits,
  getCircuitTagsForCode,
  getCircuitsForCode,
  getToolsForCircuits,
} from "../../lib/queries";
import type { CircuitSort, CircuitSortField } from "../../types";
import { notFound } from "../../lib/not-found";

const { code: codeSlug } = Astro.params;
const code = getCodeBySlug(codeSlug!);

if (!code) {
  return notFound();
}

const tags = getTagsFor("code", code.id);
const params = formatCodeParams(code);

const matricesUrl = code.canonical_hash
  ? `/api/codes/${codeSlug}/matrices?v=${code.canonical_hash}`
  : `/api/codes/${codeSlug}/matrices`;

// Filtering/sorting happens client-side (list-filter-client.ts): the page
// always renders the full list in the default order and ignores filter
// params, so every visit shares one cached document. The default sort must
// match list-filter-client's defaultSort config below.
const DEFAULT_SORT: CircuitSort = { field: "two_qubit_gate_count", dir: "asc" };

const showWeight = codeHasWeightedCircuits(code.id);
const circuits = getCircuitsForCode(code.id, DEFAULT_SORT);
const totalCount = circuits.length;
const allCircuitTags = getCircuitTagsForCode(code.id);
const toolsMap = getToolsForCircuits(circuits.map((c) => c.id));

const countLabel = `${totalCount} circuit${totalCount !== 1 ? "s" : ""}`;

const basePath = `/codes/${codeSlug}`;
// Standalone sort hrefs; clicks are intercepted client-side.
const sortHref = (field: CircuitSortField) => `${basePath}?sort=${field}&sort_dir=asc`;

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const pageUrl = `${siteUrl}/codes/${codeSlug}`;
const codeTitle = params && code.name !== params ? `${code.name} ${params}` : code.name;
const collection: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${pageUrl}#code`,
  url: pageUrl,
  name: codeTitle,
  description: `Quantum error correction circuits for the ${codeTitle}.`,
  isPartOf: { "@id": `${siteUrl}/#website` },
  about: {
    "@type": "DefinedTerm",
    name: code.name,
    url: pageUrl,
    ...(params ? { termCode: params } : {}),
    ...(code.zoo_url ? { sameAs: code.zoo_url } : {}),
  },
};
// The page is always the canonical full list (filtering is client-side).
// Cap the enumeration to bound head size; numberOfItems keeps the true total.
collection.mainEntity = {
  "@type": "ItemList",
  numberOfItems: totalCount,
  itemListElement: circuits.slice(0, 200).map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    url: `${siteUrl}/circuits/${c.qec_id}`,
  })),
};
const jsonLd = [
  collection,
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Codes", item: `${siteUrl}/codes` },
      { "@type": "ListItem", position: 2, name: codeTitle, item: pageUrl },
    ],
  },
];
---

<Layout
  title={code.name}
  description={`Circuits for ${code.name}${params && code.name !== params ? ` ${params}` : ""}`}
  jsonLd={jsonLd}
>
  <a
    href="/codes"
    class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 mb-4"
    title="Back to Codes — Backspace or b"
    data-back-link
  >
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 19l-7-7 7-7" />
    </svg>
    Codes
    <kbd class="inline-block min-w-[1rem] text-center px-1 rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-[10px] text-gray-400 dark:text-gray-500 font-mono">
      ⌫
    </kbd>
  </a>

  <div class="flex items-baseline flex-wrap gap-x-3.5 gap-y-1 mb-2">
    <h1 class="text-2xl font-bold">
      {code.name}
      {params !== "" && code.name !== params && <span class="text-gray-500 dark:text-gray-400 font-normal">{params}</span>}
    </h1>
    {code.zoo_url && (
      <a
        href={code.zoo_url}
        class="text-[13px] font-medium text-gray-600 dark:text-gray-400 underline decoration-gray-300 dark:decoration-gray-600 hover:text-gray-900 dark:hover:text-gray-100 hover:decoration-gray-500 dark:hover:decoration-gray-400"
        target="_blank"
        rel="noopener"
      >
        View on QEC Zoo<span class="ml-0.5 opacity-65">&#x2197;</span>
      </a>
    )}
  </div>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-4">
    <TagList tags={tags} basePath="/codes" />
  </div>

  {code.has_matrices === 1 && (
    <div class="mb-6">
      <CollapsibleSection id="matrices" label="Check Matrices & Logical Operators">
        <CodeMatrices id="code-matrices" dataUrl={matricesUrl} />
      </CollapsibleSection>
    </div>
  )}

  <div class="flex items-baseline justify-between mb-2">
    <h2 class="text-lg font-semibold">Circuits</h2>
    <div class="flex items-center gap-4">
      {circuits.length > 0 && (
        <button
          id="download-all-btn"
          class="flex items-center gap-1 text-[13px] text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-800 px-1.5 py-1 rounded-md cursor-pointer"
          data-code-slug={codeSlug}
          title="Download all visible circuits — Shift+D"
          aria-label="Download all visible circuits"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" />
          </svg>
          <span data-list-count>{countLabel}</span>
          <kbd class="ml-0.5 inline-block min-w-[1rem] text-center px-1 rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-[10px] text-gray-400 dark:text-gray-500 font-mono">
            ⇧D
          </kbd>
        </button>
      )}
      {circuits.length === 0 && (
        <span class="text-[13px] text-gray-500 dark:text-gray-400 px-1.5 py-1">{countLabel}</span>
      )}
      <button
        type="button"
        id="fav-filter-toggle"
        class="flex items-center gap-1 text-[13px] text-gray-500 dark:text-gray-400 aria-pressed:text-red-500 dark:aria-pressed:text-red-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-800 px-1.5 py-1 rounded-md cursor-pointer"
        title="Show favorites only — Shift+F"
        aria-pressed="false"
      >
        <HeartIcon class="w-3.5 h-3.5" />
        <span>Favorites</span>
        <kbd class="ml-0.5 inline-block min-w-[1rem] text-center px-1 rounded border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-[10px] text-gray-400 dark:text-gray-500 font-mono">
          ⇧F
        </kbd>
      </button>
    </div>
  </div>

  <CircuitFilter showWeight={showWeight} allTags={allCircuitTags} codeSlug={codeSlug!} />

  {circuits.length === 0 ? (
    <div class="text-center py-8">
      <p class="text-gray-500 dark:text-gray-400 mb-2">No circuits yet for this code.</p>
    </div>
  ) : (
    <div>
      {/* Headers only above md: below it the row has no metric columns to head,
          and the numbers carry their own labels. Sorting stays reachable there
          through the filter boxes, whose labels are the same sort links. */}
      <div
        class="hidden md:grid items-center gap-x-1.5 px-4 py-1.5 text-[11px] font-bold tracking-wider uppercase text-gray-500 dark:text-gray-400"
        style="grid-template-columns: var(--circuit-grid);"
      >
        <span></span>
        <span></span>
        <span></span>
        <a href={sortHref("gate_count")} data-sort-field="gate_count" data-sort-header class="text-center hover:text-gray-900 dark:hover:text-gray-100" title="Gate count — click to sort">G</a>
        <a href={sortHref("two_qubit_gate_count")} data-sort-field="two_qubit_gate_count" data-sort-header class="text-center hover:text-gray-900 dark:hover:text-gray-100 text-amber-600 dark:text-amber-400" title="Two-qubit gate count — click to sort">2Q</a>
        <a href={sortHref("depth")} data-sort-field="depth" data-sort-header class="text-center hover:text-gray-900 dark:hover:text-gray-100" title="Circuit depth — click to sort">D</a>
        <a href={sortHref("qubit_count")} data-sort-field="qubit_count" data-sort-header class="text-center hover:text-gray-900 dark:hover:text-gray-100" title="Qubit count — click to sort">Q</a>
        <span></span>
        <span>Name</span>
      </div>
      <div data-list-empty class="hidden text-center py-8">
        <p class="text-gray-500 dark:text-gray-400 mb-2">No circuits match your filters.</p>
        <a href={basePath} data-clear-filters class="text-sm underline text-gray-500 hover:text-gray-900 dark:hover:text-gray-100">Clear filters</a>
      </div>
      <div class="space-y-2" data-list-container>
        {circuits.map((circuit) => (
          <CircuitRow circuit={circuit} tool={toolsMap.get(circuit.id)} codeSlug={codeSlug!} />
        ))}
      </div>
    </div>
  )}

  <CircuitBodiesTemplate />
</Layout>

<script>
  import { getFavorites } from "../../lib/favorites-client";
  import { initListKeynav } from "../../lib/list-keynav-client";
  import { initListFilter } from "../../lib/list-filter-client";
  import { initCircuitActions } from "../../lib/circuit-actions-client";
  import { initBackKey } from "../../lib/back-key-client";
  import { initCircuitBodies } from "../../lib/circuit-bodies-client";

  initBackKey("/codes");
  initCircuitBodies();

  // Client-side filtering/sorting; must run before keynav so its initial
  // focus lands on a visible row. defaultSort mirrors the page's SSR order.
  initListFilter({
    formSelector: "#circuit-filter",
    // `weight` filters from the URL even on codes without a weight input,
    // matching the previous server behavior.
    fields: ["gate_count", "two_qubit_gate_count", "depth", "qubit_count", "weight"],
    rowSelector: "[data-filter-row]",
    containerSelector: "[data-list-container]",
    basePath: window.location.pathname,
    countSelector: "[data-list-count]",
    formatCount: (visible, total, active) =>
      active
        ? `${visible} of ${total} circuit${total !== 1 ? "s" : ""}`
        : `${total} circuit${total !== 1 ? "s" : ""}`,
    emptyStateSelector: "[data-list-empty]",
    defaultSort: { field: "two_qubit_gate_count", dir: "asc" },
  });

  initListKeynav({
    rowSelector: "[data-list-row]",
    enterSelector: "[data-list-detail-link]",
    expandable: true,
    expandSelfClick: true,
    favoritable: true,
    favoriteSelector: "[data-list-fav]",
    favoriteFilterSelector: "#fav-filter-toggle",
    // The id="<qec_id>" lives on the wrapping div, not on .circuit-toggle
    // (= the focusable row). Match the hash via data-qec-id which IS on the
    // toggle, so /codes/foo#42 focuses (and the existing expandFromHash
    // handler expands) the right row.
    hashAttr: "data-qec-id",
  });

  // 1/2/3 + c/y + d target the currently expanded circuit row (if any);
  // Shift+D triggers the page-level "download all visible" button.
  initCircuitActions({
    activeContainerSelector:
      '[id] > .circuit-toggle[aria-expanded="true"] + .circuit-detail',
    downloadAllSelector: "#download-all-btn",
  });

  const FAV_FILTER_LS_KEY = "qecirc:fav-filter-active";

  function applyFavFilter(active: boolean): void {
    const favSet = new Set(getFavorites());
    document.querySelectorAll("[id] > .circuit-toggle").forEach(function (toggle) {
      const row = toggle.closest("[id]") as HTMLElement;
      if (!row || !row.id || isNaN(Number(row.id))) return;
      const qecId = Number(row.id);
      row.style.display = active && !favSet.has(qecId) ? "none" : "";
    });
  }

  const favToggle = document.getElementById("fav-filter-toggle");
  if (favToggle) {
    let active = localStorage.getItem(FAV_FILTER_LS_KEY) === "true";
    if (active) {
      favToggle.setAttribute("aria-pressed", "true");
      applyFavFilter(true);
    }
    favToggle.addEventListener("click", function () {
      active = !active;
      favToggle.setAttribute("aria-pressed", active ? "true" : "false");
      localStorage.setItem(FAV_FILTER_LS_KEY, String(active));
      applyFavFilter(active);
    });
  }

  const downloadBtn = document.getElementById("download-all-btn");
  if (downloadBtn) {
    downloadBtn.addEventListener("click", async function () {
      const slug = (downloadBtn as HTMLElement).dataset.codeSlug;
      if (!slug) return;
      const params = new URLSearchParams(window.location.search);
      params.set("code", slug);
      downloadBtn.classList.add("opacity-50", "pointer-events-none");
      try {
        const resp = await fetch(`/api/download?${params}`);
        if (!resp.ok) return;
        const blob = await resp.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        const disposition = resp.headers.get("Content-Disposition") ?? "";
        const match = disposition.match(/filename="(.+)"/);
        a.download = match ? match[1] : `${slug}_circuits.stim.zip`;
        a.click();
        URL.revokeObjectURL(url);
        if (typeof window.showCiteToast === "function") {
          window.showCiteToast("Please cite the corresponding sources when using these circuits.");
        }
      } finally {
        downloadBtn.classList.remove("opacity-50", "pointer-events-none");
      }
    });
  }
</script>
