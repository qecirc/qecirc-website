{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  minimumReleaseAge: "7 days",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":automergeDigest",
    ":combinePatchMinorReleases",
    ":configMigration",
    ":enablePreCommit",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
  ],
  enabledManagers: ["github-actions", "npm", "pep621", "pre-commit"],
  lockFileMaintenance: { enabled: true, automerge: true },
  labels: ["dependencies"],
  schedule: ["every weekend"],
  packageRules: [
    {
      matchManagers: ["github-actions"],
      addLabels: ["github-actions"],
      commitMessagePrefix: "chore(ci)",
    },
    {
      matchManagers: ["npm"],
      addLabels: ["javascript"],
      commitMessagePrefix: "chore(deps)",
    },
    {
      matchManagers: ["pep621"],
      addLabels: ["python"],
      commitMessagePrefix: "chore(deps)",
    },
    {
      matchManagers: ["pre-commit"],
      addLabels: ["pre-commit"],
      commitMessagePrefix: "chore(ci)",
      versioning: "pep440",
    },
    {
      description: "Auto-merge patch updates (grouped per manager so unrelated ecosystems don't share a PR)",
      groupName: "patch updates ({{manager}})",
      matchUpdateTypes: ["patch"],
      matchCurrentVersion: "!/^0\\.0/",
      automerge: true,
    },
    {
      description: "Auto-merge minor updates of stable (>=1.0) deps (grouped per manager)",
      groupName: "minor stable updates ({{manager}})",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^0\\./",
      automerge: true,
    },

    {
      // @astrojs/check (peer `^5 || ^6`) and typescript-eslint (peer `<6.1.0`)
      // don't accept TS 7 yet; #174 failed `npm ci` on exactly that. Lift this
      // once both widen their peer range.
      description: "Hold TypeScript below 7 until its tooling peers support it",
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },

    // Last, so nothing above can hand the automerge back.
    //
    // `mqt-qecc` runs inside the circuit ingestion pipeline, and both call sites
    // (`compute.py`'s `CSSCode`, `compute_circuit.py`'s `compact_stim_circuit`)
    // swallow exceptions and fall back, so a behaviour change upstream passes CI
    // unnoticed. It used to be pinned to a git branch, which let a digest bump
    // land arbitrary upstream code unread (f476ffa1); it is a PyPI release range
    // now, but the silent fallbacks still mean a green CI proves nothing about it.
    // These rules keep the updates coming and take away only the automerge, for
    // each route a new mqt-qecc can arrive by: its own update, a `uv.lock`
    // refresh re-resolving it inside the range, and any future git-sourced pin.
    {
      description: "Never auto-merge an mqt-qecc update — its call sites fall back silently",
      matchPackageNames: ["mqt-qecc"],
      automerge: false,
      addLabels: ["needs-manual-review"],
    },
    {
      description: "Never auto-merge a git-sourced dependency — its ref is mutable",
      matchDatasources: ["git-refs", "git-tags"],
      automerge: false,
      addLabels: ["needs-manual-review"],
    },
    {
      description: "Never auto-merge a uv.lock refresh — it can move mqt-qecc within its range",
      matchManagers: ["pep621"],
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: false,
      addLabels: ["needs-manual-review"],
    },
  ],
}
